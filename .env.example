# API keys — MUST override these, empty/placeholder defaults are useless
JWT_SECRET=your-actual-random-secret-here
OPENAI_API_KEY=your-real-openai-api-key
OPENAI_API_KEY=your-real-openai-api-key
LANGCHAIN_API_KEY=your-real-langchain-api-key
LANGCHAIN_TRACING_V2=true
PAGEINDEX_API_KEY=your-real-pageindex-api-key

# Service URLs — usually leave as-is if running via docker compose
GPTCACHE_URL=http://gptcache:8001
MONGODB_URI=mongodb://mongodb:27017
POSTGRES_DSN=postgresql://postgres:postgres@postgres:5432/support_bot

# Tuning — optional, only add if you want to change from defaults
MAX_INPUT_CHARS=4000
MAX_SESSION_TURNS=10
FAITHFULNESS_THRESHOLD=0.7
COMPLETENESS_THRESHOLD=0.6

# Model selection — optional
LOW_COMPLEXITY_MODEL=gemini-2.0-flash
HIGH_COMPLEXITY_MODEL=gemini-2.5-pro